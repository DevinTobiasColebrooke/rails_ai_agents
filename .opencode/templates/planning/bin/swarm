#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/swarm — provision an isolated workspace for one parallel swarm.
#
# The user never runs this; the autopilot does, on intake. Each `opencode`
# window that is told to do work gets its own worktree + branch + Postgres DB +
# ports, then the autopilot relocates its session into it. That is what makes
# many windows safe to run in parallel.
#
# Usage:
#   bin/swarm start [--lane NAME] [--prepare]   # allocate + print SWARM_JSON
#   bin/swarm list                              # active swarms
#   bin/swarm env <n>                           # shell exports for swarm N
#   bin/swarm run <n> -- <cmd...>               # run a command in swarm N's worktree
#   bin/swarm finish <n> [--force]              # remove worktree + branch + drop DBs
#
# Isolation unit is the SWARM, not the lane. The lane is just a label carried
# on `.lane` so planning resolves to docs/planning/lanes/<lane>/ (each swarm has
# its own worktree copy, so parallel swarms never collide).

require "json"
require "fileutils"
require "optparse"

ROOT     = File.expand_path("..", __dir__)
APP      = File.basename(ROOT).gsub(/[^a-zA-Z0-9_]/, "_")
PG_PORT  = ENV.fetch("PGPORT", "5434")

def common_git_dir
  dir = `git -C #{ROOT} rev-parse --git-common-dir 2>/dev/null`.strip
  abort "bin/swarm: not a git repository (#{ROOT})" if dir.empty?
  File.expand_path(dir, ROOT)
end

def registry_path
  File.join(common_git_dir, "opencode_swarms.json")
end

def with_registry
  path = registry_path
  FileUtils.mkdir_p(File.dirname(path))
  File.open("#{path}.lock", "w") do |lock|
    lock.flock(File::LOCK_EX)
    reg = File.exist?(path) ? JSON.parse(File.read(path)) : { "next_n" => 1, "swarms" => {} }
    result = yield reg
    File.write(path, JSON.pretty_generate(reg))
    result
  end
end

def read_registry
  path = registry_path
  File.exist?(path) ? JSON.parse(File.read(path)) : { "next_n" => 1, "swarms" => {} }
end

def start(lane, prepare)
  lane = (lane || "default").gsub(/[^a-zA-Z0-9_-]/, "")
  swarm = with_registry do |reg|
    n = reg["next_n"]
    reg["next_n"] = n + 1
    tid = reg["next_ticket"] || 5000
    bid = reg["next_bug"] || 700
    reg["next_ticket"] = tid + 50
    reg["next_bug"] = bid + 10
    record = {
      "n" => n,
      "lane" => lane,
      "worktree" => File.expand_path("../#{APP}-#{lane}-#{n}", ROOT),
      "branch" => "swarm/#{lane}-#{n}",
      "database" => "#{APP}_swarm#{n}",
      "port" => 3200 + (n * 10),
      "ticket_block" => "T-#{tid}..T-#{tid + 49}",
      "bug_block" => "T-BUG-#{bid}..T-BUG-#{bid + 9}"
    }
    reg["swarms"][n.to_s] = record
    record
  end

  wt = swarm["worktree"]
  abort "Swarm workspace already exists: #{wt}" if File.directory?(wt)

  unless system("git", "-C", ROOT, "worktree", "add", "-b", swarm["branch"], wt, "main")
    abort "git worktree add failed"
  end

  write_workspace(swarm)
  %w[dev test].each do |env|
    system("createdb", "-p", PG_PORT, "#{swarm["database"]}_#{env}", err: File::NULL) ||
      warn("  (database #{swarm["database"]}_#{env} already exists)")
  end

  if prepare
    envs = { "DATABASE_URL" => "postgres://localhost:#{PG_PORT}/#{swarm["database"]}_dev" }
    system(envs, "bin/rails", "db:prepare", chdir: wt) || warn("  (db:prepare failed — run it before tests)")
  end

  puts "Swarm ##{swarm["n"]} ready — lane #{swarm["lane"]}"
  puts "  worktree: #{wt}"
  puts "  branch:   #{swarm["branch"]}"
  puts "  database: #{swarm["database"]}_dev / _test"
  puts "  port:     #{swarm["port"]}"
  puts "  ticket ids: #{swarm["ticket_block"]}   bug ids: #{swarm["bug_block"]}"
  puts "SWARM_JSON: #{JSON.generate(swarm)}"
end

def write_workspace(swarm)
  wt = swarm["worktree"]
  File.write(File.join(wt, ".lane"), "#{swarm["lane"]}\n")
  File.write(File.join(wt, ".env.lane"), <<~ENV)
    # Generated by bin/swarm for swarm ##{swarm["n"]} (lane #{swarm["lane"]}). Not committed.
    export DATABASE_URL="postgres://localhost:#{PG_PORT}/#{swarm["database"]}_dev"
    export TEST_DATABASE_URL="postgres://localhost:#{PG_PORT}/#{swarm["database"]}_test"
    export LANE=#{swarm["lane"]}
    export SWARM=#{swarm["n"]}
    export PORT=#{swarm["port"]}
  ENV
  exclude = `git -C #{wt} rev-parse --git-path info/exclude 2>/dev/null`.strip
  return if exclude.empty? || !File.exist?(exclude)

  content = File.read(exclude)
  %w[/.lane /.env.lane].each do |line|
    content += "#{line}\n" unless content.include?(line)
  end
  File.write(exclude, content)
end

def find_swarm(n)
  read_registry["swarms"][n.to_s] or abort "Unknown swarm ##{n}. See: bin/swarm list"
end

def list
  reg = read_registry
  if reg["swarms"].empty?
    puts "No active swarms."
    return
  end
  puts format("%-4s %-14s %-10s %s", "N", "LANE", "PRESENT", "WORKTREE")
  reg["swarms"].each_value do |s|
    present = File.directory?(s["worktree"]) ? "yes" : "no"
    puts format("%-4s %-14s %-10s %s", s["n"], s["lane"], present, s["worktree"])
  end
end

def env(n)
  s = find_swarm(n)
  puts "export DATABASE_URL=\"postgres://localhost:#{PG_PORT}/#{s["database"]}_dev\""
  puts "export TEST_DATABASE_URL=\"postgres://localhost:#{PG_PORT}/#{s["database"]}_test\""
  puts "export LANE=#{s["lane"]}"
  puts "export SWARM=#{s["n"]}"
  puts "export PORT=#{s["port"]}"
end

def run(n, cmd)
  s = find_swarm(n)
  abort "Worktree missing: #{s["worktree"]}" unless File.directory?(s["worktree"])
  abort "no command given" if cmd.empty?
  exec({ "DATABASE_URL" => "postgres://localhost:#{PG_PORT}/#{s["database"]}_dev",
         "LANE" => s["lane"], "SWARM" => s["n"].to_s, "PORT" => s["port"].to_s },
       *cmd, chdir: s["worktree"])
end

def finish(n, force)
  s = with_registry { |reg| reg["swarms"].delete(n.to_s) }
  abort "Unknown swarm ##{n}." unless s

  if File.directory?(s["worktree"])
    args = ["git", "-C", ROOT, "worktree", "remove", s["worktree"]]
    args << "--force" if force
    system(*args) || warn("worktree remove failed")
  end
  system("git", "-C", ROOT, "branch", "-D", s["branch"])
  %w[dev test].each { |e| system("dropdb", "-p", PG_PORT, "#{s["database"]}_#{e}", err: File::NULL) }
  puts "Finished swarm ##{n}."
end

command = ARGV.shift
case command
when "start"
  opts = {}
  OptionParser.new do |o|
    o.on("--lane NAME") { |v| opts[:lane] = v }
    o.on("--prepare") { opts[:prepare] = true }
  end.parse!(ARGV)
  start(opts[:lane], opts[:prepare])
when "list", nil
  list
when "env"
  env(ARGV.shift)
when "run"
  n = ARGV.shift
  ARGV.shift if ARGV.first == "--"
  run(n, ARGV)
when "finish"
  force = false
  OptionParser.new { |o| o.on("--force") { force = true } }.parse!(ARGV)
  finish(ARGV.shift, force)
else
  abort "Unknown command '#{command}'. See bin/swarm (start|list|env|run|finish)."
end
