#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/lane — manage swarm lanes (worktree + branch + DB + ports + board).
#
# A lane is a fully isolated working copy so a swarm can build without
# colliding with other swarms. See docs/planning/lanes.json and
# docs/planning/lanes/README.md.
#
# Usage:
#   bin/lane list
#   bin/lane info <lane>
#   bin/lane create <lane> [--base main]   # worktree + branch + .env.lane + DBs
#   bin/lane env <lane>                    # print shell exports
#   bin/lane run <lane> -- <command...>    # run a command inside the worktree
#   bin/lane sync <lane> [--base main]     # rebase lane branch on base
#   bin/lane remove <lane> [--force]       # remove worktree (keeps branch)

require "json"
require "fileutils"
require "optparse"
require "shellwords"

ROOT       = File.expand_path("..", __dir__)
LANES_JSON = File.join(ROOT, "docs", "planning", "lanes.json")

abort "lanes.json not found: #{LANES_JSON}" unless File.exist?(LANES_JSON)
CONFIG = JSON.parse(File.read(LANES_JSON))
LANES  = CONFIG["lanes"].to_h { |l| [l["id"], l] }

def lane!(id)
  LANES[id] || abort("Unknown lane '#{id}'. Known: #{LANES.keys.join(', ')}")
end

def abs_worktree(lane)
  File.expand_path(lane["worktree"], ROOT)
end

def sh(*cmd, **opts)
  system(*cmd, **opts)
end

def capture(*cmd)
  `#{cmd.map { |c| c.to_s }.join(' ')} 2>&1`.strip
end

def worktree_branch(lane)
  lane["branch"]
end

def create(lane, base)
  wt = abs_worktree(lane)
  branch = worktree_branch(lane)
  if File.exist?(wt) && !Dir.empty?(wt)
    abort "Worktree already exists: #{wt}"
  end
  unless sh("git", "-C", ROOT, "rev-parse", "--verify", base)
    abort "Base ref not found: #{base}"
  end
  puts "Creating worktree #{wt} on #{branch} (base #{base})..."
  exec_ok = sh("git", "-C", ROOT, "worktree", "add", "-b", branch, wt, base) ||
            sh("git", "-C", ROOT, "worktree", "add", wt, branch)
  abort "git worktree add failed" unless exec_ok

  write_env(lane, wt)
  create_dbs(lane)
  puts <<~MSG

    Lane '#{lane["id"]}' ready.
      worktree: #{wt}
      branch:   #{branch}
      marker:   .lane (lane-aware agents resolve their planning root from it)

    Next:
      eval "$(bin/lane env #{lane["id"]})"
      bin/lane run #{lane["id"]} -- bin/setup
  MSG
end

def write_env(lane, wt)
  dev  = lane.dig("database", "dev")
  test = lane.dig("database", "test")
  port = lane.dig("ports", "server")
  pw   = lane.dig("ports", "playwright")
  body = <<~ENV
    # Generated by bin/lane for lane '#{lane["id"]}'. Git-excluded; do not commit.
    export DATABASE_URL="postgres://localhost:5434/#{dev}"
    export TEST_DATABASE_URL="postgres://localhost:5434/#{test}"
    export PORT=#{port}
    export PLAYWRIGHT_PORT=#{pw}
    export LANE=#{lane["id"]}
  ENV
  path = File.join(wt, ".env.lane")
  File.write(path, body)
  File.write(File.join(wt, ".lane"), "#{lane["id"]}\n")
  exclude_lane_files(wt, %w[/.env.lane /.lane])
end

# Mark lane-local files as never-committed in the worktree. In a linked worktree
# `.git` is a file, so resolve the common exclude path via git itself.
def exclude_lane_files(wt, paths)
  exclude = `git -C #{Shellwords.escape(wt)} rev-parse --git-path info/exclude 2>/dev/null`.strip
  return if exclude.empty? || !File.exist?(exclude)

  content = File.read(exclude)
  added = paths.reject { |p| content.include?(p) }
  return if added.empty?

  content += "\n" unless content.empty? || content.end_with?("\n")
  File.write(exclude, content + added.join("\n") + "\n")
end

def create_dbs(lane)
  %w[dev test].each do |which|
    db = lane.dig("database", which)
    next unless db
    if system("createdb -p 5434 #{db} 2>/dev/null")
      puts "  created database #{db}"
    else
      puts "  database #{db} already exists (or createdb unavailable)"
    end
  end
end

def env(lane)
  puts "export DATABASE_URL=\"postgres://localhost:5434/#{lane.dig("database", "dev")}\""
  puts "export TEST_DATABASE_URL=\"postgres://localhost:5434/#{lane.dig("database", "test")}\""
  puts "export PORT=#{lane.dig("ports", "server")}"
  puts "export PLAYWRIGHT_PORT=#{lane.dig("ports", "playwright")}"
  puts "export LANE=#{lane["id"]}"
  puts "export LANE_WORKTREE=#{abs_worktree(lane)}"
end

def sync(lane, base)
  wt = abs_worktree(lane)
  abort "Worktree missing: #{wt}" unless File.directory?(wt)
  sh("git", "-C", wt, "fetch", "origin") unless ENV["LANE_NO_FETCH"] == "1"
  ok = sh("git", "-C", wt, "fetch", "origin", base) && sh("git", "-C", wt, "rebase", "origin/#{base}")
  abort "rebase failed — resolve conflicts, then `git -C #{wt} rebase --continue`" unless ok
  puts "Lane '#{lane["id"]}' rebased on origin/#{base}."
end

def remove(lane, force)
  wt = abs_worktree(lane)
  abort "Worktree missing: #{wt}" unless File.directory?(wt)
  args = ["git", "-C", ROOT, "worktree", "remove", wt]
  args << "--force" if force
  abort "remove failed" unless sh(*args)
  puts "Removed worktree #{wt} (branch #{lane["branch"]} kept)."
end

def list
  puts format("%-12s %-32s %-18s %-8s %s", "LANE", "NAME", "BRANCH", "STATUS", "WORKTREE")
  LANES.each_value do |l|
    wt = l["worktree"] ? abs_worktree(l) : "-"
    present = l["worktree"] && File.directory?(wt) ? "ok" : "—"
    puts format("%-12s %-32s %-18s %-8s %s",
                l["id"], l["name"], l["branch"] || "-", present, wt)
  end
end

def info(lane)
  wt = lane["worktree"] ? abs_worktree(lane) : nil
  puts "#{lane["name"]} (#{lane["id"]})"
  puts "  status:     #{lane["status"]}"
  puts "  branch:     #{lane["branch"]}"
  puts "  worktree:   #{wt} #{wt && File.directory?(wt) ? '[present]' : '[not created]'}"
  puts "  database:   #{lane.dig("database", "dev")} / #{lane.dig("database", "test")}"
  puts "  ports:      #{lane.dig("ports", "server")} (playwright #{lane.dig("ports", "playwright")})"
  puts "  ticket ids: #{lane["ticket_block"]}"
  puts "  bug ids:    #{lane["bug_block"]}"
  puts "  epics:      #{Array(lane["epics"]).join(", ")}"
  puts "  owns:"
  Array(lane["owns"]).each { |o| puts "    - #{o}" }
  puts "  reads:"
  Array(lane["reads"]).each { |r| puts "    - #{r}" }
end

command = ARGV.shift
def open_lane(argv, base)
  id = argv.first
  if id.nil? || id.start_with?("-")
    free = LANES.values.find do |l|
      l["status"] == "ready" && l["worktree"] && !File.directory?(abs_worktree(l))
    end
    abort "All lanes are in use. Free one with: bin/lane remove <lane> (or add a lane to lanes.json)." unless free

    id = free["id"]
  else
    argv.shift
  end
  argv.shift if argv.first == "--"

  lane = lane!(id)
  wt = abs_worktree(lane)
  if File.directory?(wt)
    abort "Lane '#{id}' is already active (#{wt}). Another swarm owns it — " \
          "pick another lane (bin/lane list) or remove it when idle (bin/lane remove #{id})."
  end

  puts "Opening swarm for lane '#{id}' in #{wt} ..."
  create(lane, base)

  cmd = argv.empty? ? [ENV.fetch("OPENCODE_CMD", "opencode")] : argv
  exec({ "LANE" => id,
         "DATABASE_URL" => "postgres://localhost:5434/#{lane.dig("database", "dev")}",
         "PORT" => lane.dig("ports", "server").to_s },
       *cmd, chdir: wt)
end

case command
when "list", nil
  list
when "info"
  info(lane!(ARGV.shift))
when "create"
  opts = {}
  OptionParser.new { |o| o.on("--base REF") { |v| opts[:base] = v } }.parse!(ARGV)
  create(lane!(ARGV.shift), opts[:base] || "main")
when "open"
  opts = {}
  OptionParser.new { |o| o.on("--base REF") { |v| opts[:base] = v } }.parse!(ARGV)
  open_lane(ARGV, opts[:base] || "main")
when "env"
  env(lane!(ARGV.shift))
when "sync"
  opts = {}
  OptionParser.new { |o| o.on("--base REF") { |v| opts[:base] = v } }.parse!(ARGV)
  sync(lane!(ARGV.shift), opts[:base] || "main")
when "remove"
  opts = {}
  OptionParser.new { |o| o.on("--force") { opts[:force] = true } }.parse!(ARGV)
  remove(lane!(ARGV.shift), opts[:force])
when "run"
  id = ARGV.shift
  ARGV.shift if ARGV.first == "--"
  l = lane!(id)
  wt = abs_worktree(l)
  abort "Worktree missing: #{wt}" unless File.directory?(wt)
  abort "no command given" if ARGV.empty?
  exec({ "DATABASE_URL" => "postgres://localhost:5434/#{l.dig("database", "dev")}",
         "PORT" => l.dig("ports", "server").to_s }, *ARGV, chdir: wt)
else
  abort "Unknown command '#{command}'. See bin/lane (list|info|create|open|env|run|sync|remove)."
end
