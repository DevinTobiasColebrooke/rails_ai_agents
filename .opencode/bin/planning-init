#!/bin/sh
# planning-init — equip a project with the planning board scaffold (idempotent).
#
# Copies the template into the project only where files are missing, then runs
# the project's `bin/kanban init`. Never overwrites existing files or boards.
#
# Usage: planning-init [project-dir]   (defaults to the current directory)

set -eu

proj="${1:-$PWD}"
here=$(cd "$(dirname "$0")" && pwd)
tpl="$here/../templates/planning"

if [ ! -d "$tpl" ]; then
  echo "planning-init: template not found at $tpl" >&2
  exit 1
fi

mkdir -p "$proj/bin" "$proj/script"

for rel in bin/kanban bin/lane bin/swarm script/shard_kanban.rb script/rollup_kanban.rb script/planning_guard.rb; do
  src="$tpl/$rel"
  dest="$proj/$rel"
  if [ -e "$dest" ]; then
    echo "keep    $rel"
  else
    cp "$src" "$dest"
    echo "install $rel"
  fi
done

chmod +x "$proj/bin/kanban" "$proj/bin/lane" "$proj/bin/swarm" 2>/dev/null || true

if [ -x "$proj/bin/kanban" ]; then
  ( cd "$proj" && ./bin/kanban init )
else
  echo "planning-init: bin/kanban is not executable in $proj" >&2
  exit 1
fi
